    "lines": [
      {
        "snippetId": "s804",
        "messageOrdinal": 42,
        "sender": "Elizabeth",
        "date": "1845-06-17",
        "approximate": false,
        "dateLabel": "17 June 1845",
        "text": "But I thank you--for this, and all, my dear friend.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s5234",
        "messageOrdinal": 274,
        "sender": "Elizabeth",
        "date": "1846-03-20",
        "approximate": false,
        "dateLabel": "20 March 1846",
        "text": "Yet to bring you down into my ashes ... that has been so intolerable a possibility to me from the first.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s5252",
        "messageOrdinal": 275,
        "sender": "Robert",
        "date": "1846-03-21",
        "approximate": false,
        "dateLabel": "21 March 1846",
        "text": "I cannot thank you, know not how to thank you for the notes!",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s5420",
        "messageOrdinal": 282,
        "sender": "Elizabeth",
        "date": "1846-03-26",
        "approximate": false,
        "dateLabel": "26 March 1846",
        "text": "For me, I was going down-stairs to-day, but it was wet and windy and I was warned not to go.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s6422",
        "messageOrdinal": 323,
        "sender": "Elizabeth",
        "date": "1846-04-22",
        "approximate": false,
        "dateLabel": "22 April 1846",
        "text": "For me, I am the fly on the chariot, ...",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s7205",
        "messageOrdinal": 357,
        "sender": "Robert",
        "date": "1846-05-15",
        "approximate": false,
        "dateLabel": "15 May 1846",
        "text": "I do the thing, the precise thing!",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s7523",
        "messageOrdinal": 375,
        "sender": "Elizabeth",
        "date": "1846-05-26",
        "approximate": false,
        "dateLabel": "26 May 1846",
        "text": "Not that I usen’t to fancy I could see you and know you, in a reflex image, in your creations!",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s8289",
        "messageOrdinal": 409,
        "sender": "Elizabeth",
        "date": "1846-06-17",
        "approximate": false,
        "dateLabel": "17 June 1846",
        "text": "I can understand everything else ...",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s9324",
        "messageOrdinal": 451,
        "sender": "Robert",
        "date": "1846-07-10",
        "approximate": false,
        "dateLabel": "10 July 1846",
        "text": "I shall consider that I may go unless a letter comes to-morrow ... which would have to be written to-day.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s9719",
        "messageOrdinal": 469,
        "sender": "Robert",
        "date": "1846-07-23",
        "approximate": false,
        "dateLabel": "23 July 1846",
        "text": "Dogs have such memories!",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s9890",
        "messageOrdinal": 475,
        "sender": "Elizabeth",
        "date": "1846-07-28",
        "approximate": false,
        "dateLabel": "28 July 1846",
        "text": "‘but I shall to-morrow.’",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s9924",
        "messageOrdinal": 476,
        "sender": "Elizabeth",
        "date": "1846-07-29",
        "approximate": false,
        "dateLabel": "29 July 1846",
        "text": "And this is all.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s10439",
        "messageOrdinal": 492,
        "sender": "Robert",
        "date": "1846-08-10",
        "approximate": false,
        "dateLabel": "10 August 1846",
        "text": "How happy you make me, now and ever—in the present happiness, in the assurance of the future’s even greater happiness, I am obliged to believe!",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s11829",
        "messageOrdinal": 541,
        "sender": "Elizabeth",
        "date": "1846-09-05",
        "approximate": false,
        "dateLabel": "5 September 1846",
        "text": "You, if you were ‘consistent’ ... dearest! ... would not redeem me on any account.",
        "note": "",
        "callbacks": []
      }
    ]
  }
}
