    "lines": [
      {
        "snippetId": "s226",
        "messageOrdinal": 8,
        "sender": "Robert",
        "date": "1845-02-26",
        "approximate": false,
        "dateLabel": "26 February 1845",
        "text": "For, as I think I told you, I always shiver involuntarily when I look--no, glance--at this First Poem of mine to be.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s617",
        "messageOrdinal": 24,
        "sender": "Elizabeth",
        "date": "1845-05-16",
        "approximate": false,
        "dateLabel": "16 May 1845",
        "text": "I entreat you not to think of coming until that is all put to silence satisfactorily.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s801",
        "messageOrdinal": 42,
        "sender": "Elizabeth",
        "date": "1845-06-17",
        "approximate": false,
        "dateLabel": "17 June 1845",
        "text": "Another day, you know, will do as well--and patience is possible to me, if not 'native to the soil.'",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s2414",
        "messageOrdinal": 155,
        "sender": "Elizabeth",
        "date": "1845-11-22",
        "approximate": false,
        "dateLabel": "22 November 1845",
        "text": "All of which was repeated to me yesterday.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s3601",
        "messageOrdinal": 202,
        "sender": "Elizabeth",
        "date": "1846-01-17",
        "approximate": true,
        "dateLabel": "c. 17 January 1846",
        "text": "In fact she had no true attachment, as I observed to Arabel at the time--a child never submitted more meekly to a revoked holiday.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s6061",
        "messageOrdinal": 310,
        "sender": "Elizabeth",
        "date": "1846-04-13",
        "approximate": false,
        "dateLabel": "13 April 1846",
        "text": "For he came to-day, and arrived in town on Friday evening—(what an escape on Saturday!) and said of you, ... with those detestable spectacles—like the Greek burning glasses, turned full on my face ...",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s7092",
        "messageOrdinal": 352,
        "sender": "Elizabeth",
        "date": "1846-05-12",
        "approximate": false,
        "dateLabel": "12 May 1846",
        "text": "There is no good reason for loving me, certainly, and my earnest desire (as I have said again and again) is, that there should be by profession no reason at all.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s7729",
        "messageOrdinal": 385,
        "sender": "Elizabeth",
        "date": "1846-06-02",
        "approximate": false,
        "dateLabel": "2 June 1846",
        "text": "Now I am going to ask you a question, dearest of mine, and you will consider it carefully and examine your own wishes in respect to it, before I have any answer.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s8231",
        "messageOrdinal": 406,
        "sender": "Elizabeth",
        "date": "1846-06-16",
        "approximate": false,
        "dateLabel": "16 June 1846",
        "text": "I repent to-day, having made the promise you asked of me.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s10203",
        "messageOrdinal": 485,
        "sender": "Elizabeth",
        "date": "1846-08-04",
        "approximate": false,
        "dateLabel": "4 August 1846",
        "text": "And you see me, my prophet, sent to Sussex or Devonshire, in a flash of lightning?",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s12139",
        "messageOrdinal": 557,
        "sender": "Elizabeth",
        "date": "1846-09-14",
        "approximate": false,
        "dateLabel": "14 September 1846",
        "text": "I did hate so, to have to take off the ring!",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s12294",
        "messageOrdinal": 561,
        "sender": "Elizabeth",
        "date": "1846-09-15",
        "approximate": false,
        "dateLabel": "15 September 1846",
        "text": "I will confide in you, to that end also.",
        "note": "",
        "callbacks": []
      }
    ]
  }
}
