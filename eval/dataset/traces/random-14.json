    "lines": [
      {
        "snippetId": "s559",
        "messageOrdinal": 20,
        "sender": "Elizabeth",
        "date": "1845-05-06",
        "approximate": false,
        "dateLabel": "6 May 1845",
        "text": "Yes--you are going to Mr. Kenyon's on the 12th--and yes--my brother and sister are going to meet you and your sister there one day to dinner.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s1036",
        "messageOrdinal": 65,
        "sender": "Elizabeth",
        "date": "1845-07-25",
        "approximate": false,
        "dateLabel": "25 July 1845",
        "text": "But the paper relating to you I never was consulted about--or in one particular way it would have been better,--as easily it might have been.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s1782",
        "messageOrdinal": 123,
        "sender": "Elizabeth",
        "date": "1845-10-08",
        "approximate": false,
        "dateLabel": "8 October 1845",
        "text": "Did the Monday work work harm to the head, I wonder?",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s2155",
        "messageOrdinal": 146,
        "sender": "Elizabeth",
        "date": "1845-11-07",
        "approximate": false,
        "dateLabel": "7 November 1845",
        "text": "But oh--the creatures of your sex are not always magnanimous--that is true.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s2975",
        "messageOrdinal": 179,
        "sender": "Elizabeth",
        "date": "1845-12-20",
        "approximate": false,
        "dateLabel": "20 December 1845",
        "text": "You never 'ought' to write to me you know! or rather ... if you ever think you ought, you ought not!",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s5759",
        "messageOrdinal": 297,
        "sender": "Robert",
        "date": "1846-04-04",
        "approximate": false,
        "dateLabel": "4 April 1846",
        "text": "Poor, cowardly miscreated natures abound—if you could throw ‘genius’ into their composition, they would become more degraded still, I suppose!",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s8490",
        "messageOrdinal": 417,
        "sender": "Robert",
        "date": "1846-06-22",
        "approximate": false,
        "dateLabel": "22 June 1846",
        "text": "People at doors and windows are also able, alas, to see me too—so I stay ... if this is staying away when I can see the curled-up feet and kiss them beside,—ever-dear feet!",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s8543",
        "messageOrdinal": 418,
        "sender": "Elizabeth",
        "date": "1846-06-23",
        "approximate": false,
        "dateLabel": "23 June 1846",
        "text": "I will read what you tell me in Landor ... but no words of inspired lips or pen ... no poet’s word, of the divinest, ... ever went to my heart as yours in these letters!",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s8558",
        "messageOrdinal": 419,
        "sender": "Robert",
        "date": "1846-06-23",
        "approximate": false,
        "dateLabel": "23 June 1846",
        "text": "And perhaps he may be after all a mere acquaintance ... anything I will fancy that is likely to relieve you of pain!",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s11332",
        "messageOrdinal": 524,
        "sender": "Elizabeth",
        "date": "1846-08-27",
        "approximate": false,
        "dateLabel": "27 August 1846",
        "text": "I am too nervous perhaps.",
        "note": "",
        "callbacks": []
      },
      {
        "snippetId": "s11437",
        "messageOrdinal": 528,
        "sender": "Elizabeth",
        "date": "1846-08-29",
        "approximate": false,
        "dateLabel": "29 August 1846",
        "text": "Both of them approved of the French route, and urged me to go to them in Paris—‘And,’ said my uncle kindly, ‘when once we have you, we shall not bear to part with you, I think.’",
        "note": "",
        "callbacks": []
      }
    ]
  }
